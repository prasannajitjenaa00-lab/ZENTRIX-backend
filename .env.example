# ---- Runtime ----
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Behind Nginx on a VPS keep this at 1. Use 0 when exposed directly.
TRUST_PROXY=1
# Timezone used for "today", overdue and next-7-days calculations.
APP_TIMEZONE=Asia/Kolkata

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/zentrix_pulse

# ---- Web / CORS ----
# Exact origin of the React app (scheme + host [+ port]); no trailing slash.
FRONTEND_URL=http://localhost:5173

# ---- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
# 64 hex chars. Encrypts bank details at rest. Keep OUTSIDE the database; losing it makes bank data unreadable.
DATA_ENCRYPTION_KEY=
# 64 hex chars. Pepper for hashing session / reset / OTP / recovery tokens.
TOKEN_PEPPER=

# ---- Sessions (opaque cookie + server-side session record) ----
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7
TRUSTED_DEVICE_DAYS=30
COOKIE_NAME=pulse_sid
# Set to your parent domain only if the API and UI are on different subdomains. Leave empty otherwise.
COOKIE_DOMAIN=

# ---- Auth policy ----
PASSWORD_MIN_LENGTH=6
MFA_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=5
RESET_TTL_MINUTES=30
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

# ---- Uploads ----
# Local disk storage. Must be a persistent path (not inside the release folder) on the VPS.
STORAGE_DIR=./storage
MAX_AUDIO_BATCH=100
MAX_AUDIO_FILE_MB=400

# ---- Email (required in production for MFA codes and reset links) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zentrix Pulse <no-reply@your-domain.example>"
# DEVELOPMENT ONLY: include OTP/reset link in API responses (mirrors the original demo preview). Refused when NODE_ENV=production.
DEV_MAIL_PREVIEW=false
